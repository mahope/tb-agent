{
  "manifest_version": 2,
  "name": "tb-agent",
  "version": "0.10.0",
  "description": "Connect Thunderbird to the local tb-agent daemon",
  "browser_specific_settings": {
    "gecko": {
      "id": "tb-agent@mahoje.dk",
      "strict_min_version": "154.0",
      "strict_max_version": "200.*"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "page": "daemon-background.html"
  },
  "experiment_apis": {
    "mcpServer": {
      "schema": "mcp_server/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "mcpServer"
          ]
        ],
        "script": "mcp_server/api.js"
      }
    }
  },
  "options_ui": {
    "page": "daemon-options.html"
  },
  "permissions": [
    "accountsRead",
    "addressBooks",
    "messagesRead",
    "messagesMove",
    "accountsFolders",
    "compose",
    "storage",
    "messagesUpdate",
    "compose.save"
  ],
  "web_accessible_resources": []
}
